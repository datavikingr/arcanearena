// Dreamscape Theater

$: s("<hh>").gain("<.65>").coarse("6").hpf("1000").delay("0.65:0.25:0.6").speed("-1").color("#ffb86c")
$: note("<0 1 2 3 4 5 6 7 8 7 6 5 4 3 2 1>*16").scale("<G5:minor Bb5:major C5:major D5:minor>/2").sound("triangle").room("2").delay(".3").gain(".3").color("#bd93f9")
$: note("< [0,3] - [5,7] - [7,9] - [5,7] - >*4").scale("<G3:minor Bb3:major C3:major D3:minor>/2").adsr(".1:.05:.5:.1").sound("triangle").delay("0.65:0.25:0.9").room("2").gain(".25").color("#ff79c6")

all(pianoroll)